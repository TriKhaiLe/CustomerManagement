<div class="d-flex flex-column align-center justify-center @(Compact ? "py-2" : "py-3") @(Class)"
     style="@(Compact ? "gap: 0.5rem;" : "gap: 0.75rem;")">
    <MudProgressCircular Color="Color.Primary"
                         Indeterminate="true"
                         Size="@Size"
                         aria-label="Loading" />

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <MudText Typo="Typo.body2" Align="Align.Center">@Message</MudText>
    }
</div>

@code {
    [Parameter] public string? Message { get; set; } = "Loading…";

    [Parameter] public Size Size { get; set; } = Size.Medium;

    [Parameter] public bool Compact { get; set; }

    [Parameter] public string? Class { get; set; }
}
