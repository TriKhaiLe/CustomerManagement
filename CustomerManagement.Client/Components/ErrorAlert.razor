@using CustomerManagement.Client.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

@if (HasContent)
{
    <MudAlert Severity="@Severity"
              Variant="Variant.Outlined"
              Class="@Class"
              Dense="true">
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <MudText Typo="Typo.subtitle2" Class="mb-1">@Title</MudText>
        }

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <MudText Typo="Typo.body2">@Message</MudText>
        }

        @if (Messages is { Count: > 0 })
        {
            var nonEmptyMessages = Messages.Where(m => !string.IsNullOrWhiteSpace(m)).ToList();
            if (nonEmptyMessages.Count > 0)
            {
                <ul class="mb-0 mt-2 ps-4">
                    @foreach (var item in nonEmptyMessages)
                    {
                        <li>@item</li>
                    }
                </ul>
            }
        }

        @if (OnRetry.HasDelegate)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Inherit"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Class="mt-3"
                       OnClick="@(() => OnRetry.InvokeAsync())">
                @RetryText
            </MudButton>
        }
    </MudAlert>
}

@code {
    [Parameter] public string? Title { get; set; }

    [Parameter] public string? Message { get; set; }

    [Parameter] public IReadOnlyList<string>? Messages { get; set; }

    [Parameter] public Severity Severity { get; set; } = Severity.Error;

    [Parameter] public EventCallback OnRetry { get; set; }

    [Parameter] public string RetryText { get; set; } = default!;

    [Parameter] public string? Class { get; set; }

    private bool HasContent =>
        !string.IsNullOrWhiteSpace(Title)
        || !string.IsNullOrWhiteSpace(Message)
        || Messages is { Count: > 0 } && Messages.Any(m => !string.IsNullOrWhiteSpace(m));

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(RetryText))
        {
            RetryText = L["Common.Retry"];
        }
    }
}
