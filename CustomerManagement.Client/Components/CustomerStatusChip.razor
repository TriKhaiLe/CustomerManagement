@using CustomerManagement.Client.Resources
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L

<MudChip T="string"
         Color="@(IsActive ? Color.Success : Color.Default)"
         Variant="Variant.Filled"
         Size="@Size"
         Class="@Class">
    @(IsActive ? L["Customers.Active"] : L["Customers.Inactive"])
</MudChip>

@code {
    [Parameter, EditorRequired] public bool IsActive { get; set; }

    [Parameter] public Size Size { get; set; } = Size.Small;

    [Parameter] public string? Class { get; set; }
}
